{
  "name": "react-worker-uploader",
  "version": "1.0.0",
  "description": "A customizable React hook for uploading and parsing files using Web Workers",
  "main": "dist/index.js",
  "module": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts",
